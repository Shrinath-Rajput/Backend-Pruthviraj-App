# PRUTHVIRAJ Workforce & Business Management System - Environment Configuration

# Server & Runtime Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# MongoDB 7+ Configuration
MONGODB_URI=mongodb://localhost:27017/pruthviraj_db

# Redis 7+ Cache & In-Memory Store
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=pruthviraj_access_secret_super_secure_key_2026
JWT_REFRESH_SECRET=pruthviraj_refresh_secret_super_secure_key_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Verification Configuration
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=3
OTP_MAX_SEND_PER_WINDOW=3
OTP_SEND_WINDOW_SECONDS=600
ALLOW_DEV_OTP=true

# Local File & Image Storage (Upload folder & MongoDB image links)
UPLOAD_DIR=uploads
APP_URL=http://localhost:5000

# CORS & Security
CORS_ORIGINS=*
LOG_LEVEL=info

# Enterprise System Settings
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR
BIOMETRIC_THRESHOLD=80.0
DEFAULT_GEOFENCE_RADIUS_METERS=50
GPS_ACCURACY_THRESHOLD_METERS=20

# External Gateways & Integrations (Conceptual)
SMS_GATEWAY_PROVIDER=mock
WHATSAPP_GATEWAY_PROVIDER=mock
EMAIL_GATEWAY_PROVIDER=mock
TALLY_SYNC_ENABLED=true
