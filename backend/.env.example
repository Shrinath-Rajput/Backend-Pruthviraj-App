# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://localhost:27017/geowork_db

# Cache & In-Memory Store (Redis)
REDIS_URL=redis://localhost:6379

# JWT Authentication Secrets & Expiry
JWT_ACCESS_SECRET=your_super_secret_jwt_access_token_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_token_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP Verification Configuration
OTP_EXPIRY_MINUTES=5
OTP_RATE_LIMIT=3

# CORS Configuration
CORS_ORIGIN=http://localhost:3000

# AWS S3 / MinIO Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=geowork-uploads-bucket
